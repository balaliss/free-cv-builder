# Zhipu AI API key — get one free at https://open.bigmodel.cn/
GLM_API_KEY=your_zhipu_api_key_here

# Model selection (default: glm-4-flash which is FREE)
# Options: glm-4-flash, glm-4, glm-4-plus, glm-4-long, glm-z1-flash
GLM_MODEL=glm-4-flash

# Optional: override base URL (e.g. for self-hosted GLM)
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Comparison model for cost tracking (affects savings display only)
# Options: claude-3-5-sonnet, claude-3-opus, gpt-4o, gpt-4-turbo
BASELINE_MODEL=claude-3-5-sonnet

# Web server
HOST=0.0.0.0
PORT=8000
